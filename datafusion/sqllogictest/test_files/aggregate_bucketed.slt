# Final hash aggregation splits its groups into hash buckets once the table
# reaches `hash_aggregate_bucket_threshold` groups. Every query runs with the
# option off and with a tiny threshold; the results must be identical.

# The test context runs with 4 target partitions, so the aggregation is two-stage.

statement ok
set datafusion.execution.batch_size = 1024;

statement ok
create table t as select value as v from generate_series(1, 200000);

# --- hash_aggregate_bucket_threshold = 0

statement ok
set datafusion.execution.hash_aggregate_bucket_threshold = 0;

# integer key, several accumulators
query IIIII
select count(*), sum(c), sum(s), min(mn), max(mx) from (select v % 10007 as k, count(*) c, sum(v) s, min(v) mn, max(v) mx from t group by k);
----
10007 200000 20000100000 1 200000

# avg keeps sum and count as state
query IR
select count(*), round(sum(a), 3) from (select v % 10007 as k, avg(v) a from t group by k);
----
10007 1000705003.5

# string key
query II
select count(*), sum(c) from (select concat('key-', cast(v % 9973 as varchar)) as k, count(*) c from t group by k);
----
9973 200000

# string view key
query II
select count(*), sum(c) from (select arrow_cast(concat('a-long-enough-string-view-key-', cast(v % 9973 as varchar)), 'Utf8View') as k, count(*) c from t group by k);
----
9973 200000

# several key columns of mixed types
query III
select count(*), sum(c), sum(s) from (select v % 101 as k1, concat('k', cast(v % 103 as varchar)) as k2, v % 7 = 0 as k3, count(*) c, sum(v) s from t group by k1, k2, k3);
----
20806 200000 20000100000

# nullable key
query II
select count(*), sum(c) from (select case when v % 11 = 0 then null else v % 5003 end as k, count(*) c from t group by k);
----
5004 200000

# distinct has no accumulators
query I
select count(*) from (select distinct v % 20011 as k, v % 3 as j from t);
----
60033

# accumulators with list state
query II
select count(*), sum(d) from (select v % 5003 as k, count(distinct v % 17) d from t group by k);
----
5003 85051

# median
query IR
select count(*), sum(m) from (select v % 5003 as k, median(v) m from t group by k);
----
5003 500302501.5

# array_agg
query II
select count(*), sum(array_length(a)) from (select v % 5003 as k, array_agg(v) a from t group by k);
----
5003 200000

# every row its own group, largest groups first
query III
select k, c, s from (select v as k, count(*) c, sum(v) s from t group by v) order by k desc limit 3;
----
200000 1 200000
199999 1 199999
199998 1 199998

# --- hash_aggregate_bucket_threshold = 100

statement ok
set datafusion.execution.hash_aggregate_bucket_threshold = 100;

# Each of the four final partitions moved its groups into buckets once
query TT
explain analyze select count(*) from (select v % 10007 as k, count(*) c from t group by k);
----
<slt:ignore>
06)----------AggregateExec: mode=FinalPartitioned, gby=[t.v % Int64(10007)@0 as t.v % Int64(10007)], aggr=[], metrics=[<slt:ignore>bucket_splits=4,<slt:ignore>]
<slt:ignore>

# integer key, several accumulators
query IIIII
select count(*), sum(c), sum(s), min(mn), max(mx) from (select v % 10007 as k, count(*) c, sum(v) s, min(v) mn, max(v) mx from t group by k);
----
10007 200000 20000100000 1 200000

# avg keeps sum and count as state
query IR
select count(*), round(sum(a), 3) from (select v % 10007 as k, avg(v) a from t group by k);
----
10007 1000705003.5

# The next three queries have a string key, so they keep a single table: with
# hash_aggregate_bucket_threshold_bytes at 0, only fixed-width state is
# bucketed. Their results must not change.

# string key
query II
select count(*), sum(c) from (select concat('key-', cast(v % 9973 as varchar)) as k, count(*) c from t group by k);
----
9973 200000

# string view key
query II
select count(*), sum(c) from (select arrow_cast(concat('a-long-enough-string-view-key-', cast(v % 9973 as varchar)), 'Utf8View') as k, count(*) c from t group by k);
----
9973 200000

# several key columns of mixed types
query III
select count(*), sum(c), sum(s) from (select v % 101 as k1, concat('k', cast(v % 103 as varchar)) as k2, v % 7 = 0 as k3, count(*) c, sum(v) s from t group by k1, k2, k3);
----
20806 200000 20000100000

# nullable key
query II
select count(*), sum(c) from (select case when v % 11 = 0 then null else v % 5003 end as k, count(*) c from t group by k);
----
5004 200000

# distinct has no accumulators
query I
select count(*) from (select distinct v % 20011 as k, v % 3 as j from t);
----
60033

# accumulators with list state
query II
select count(*), sum(d) from (select v % 5003 as k, count(distinct v % 17) d from t group by k);
----
5003 85051

# median
query IR
select count(*), sum(m) from (select v % 5003 as k, median(v) m from t group by k);
----
5003 500302501.5

# array_agg
query II
select count(*), sum(array_length(a)) from (select v % 5003 as k, array_agg(v) a from t group by k);
----
5003 200000

# every row its own group, largest groups first
query III
select k, c, s from (select v as k, count(*) c, sum(v) s from t group by v) order by k desc limit 3;
----
200000 1 200000
199999 1 199999
199998 1 199998

# --- hash_aggregate_bucket_threshold_bytes = 65536: variable-width keys and
# state are bucketed by the bytes of their table, fixed-width ones still by
# hash_aggregate_bucket_threshold.

statement ok
set datafusion.execution.hash_aggregate_bucket_threshold_bytes = 65536;

# Each of the four final partitions moved its string groups into buckets once
query TT
explain analyze select count(*) from (select arrow_cast(concat('a-long-enough-string-view-key-', cast(v % 9973 as varchar)), 'Utf8View') as k, count(*) c from t group by k);
----
<slt:ignore>bucket_splits=4,<slt:ignore>

# string key
query II
select count(*), sum(c) from (select concat('key-', cast(v % 9973 as varchar)) as k, count(*) c from t group by k);
----
9973 200000

# string view key
query II
select count(*), sum(c) from (select arrow_cast(concat('a-long-enough-string-view-key-', cast(v % 9973 as varchar)), 'Utf8View') as k, count(*) c from t group by k);
----
9973 200000

# string view state
query IT
select count(*), min(m) from (select v % 9973 as k, min(arrow_cast(concat('a-long-enough-string-view-value-', cast(v as varchar)), 'Utf8View')) m from t group by k);
----
9973 a-long-enough-string-view-value-1

# several key columns of mixed types
query III
select count(*), sum(c), sum(s) from (select v % 101 as k1, concat('k', cast(v % 103 as varchar)) as k2, v % 7 = 0 as k3, count(*) c, sum(v) s from t group by k1, k2, k3);
----
20806 200000 20000100000

# list state keeps its single table
query II
select count(*), sum(d) from (select concat('key-', cast(v % 5003 as varchar)) as k, count(distinct v % 17) d from t group by k);
----
5003 85051

# --- carry_group_hash: the partial aggregation hashes variable-width keys
# once and the exchange and the final aggregation use that hash. Same
# results, with the buckets above and with one table.

statement ok
set datafusion.execution.carry_group_hash = true;

query TT
explain select concat('key-', cast(v % 9973 as varchar)) as k, count(*) c from t group by k;
----
logical_plan
01)Projection: concat(Utf8("key-"),t.v % Int64(9973)) AS k, count(Int64(1)) AS count(*) AS c
02)--Aggregate: groupBy=[[concat(Utf8View("key-"), CAST(t.v % Int64(9973) AS Utf8View)) AS concat(Utf8("key-"),t.v % Int64(9973))]], aggr=[[count(Int64(1))]]
03)----TableScan: t projection=[v]
physical_plan
01)ProjectionExec: expr=[concat(Utf8("key-"),t.v % Int64(9973))@0 as k, count(Int64(1))@1 as c]
02)--AggregateExec: mode=FinalPartitioned, gby=[concat(Utf8("key-"),t.v % Int64(9973))@0 as concat(Utf8("key-"),t.v % Int64(9973))], aggr=[count(Int64(1))], group_hash
03)----RepartitionExec: partitioning=Hash([concat(Utf8("key-"),t.v % Int64(9973))@0], 4), input_partitions=4
04)------AggregateExec: mode=Partial, gby=[concat(key-, CAST(v@0 % 9973 AS Utf8View)) as concat(Utf8("key-"),t.v % Int64(9973))], aggr=[count(Int64(1))], group_hash
05)--------DataSourceExec: partitions=4, partition_sizes=[49, 49, 49, 49]

query IT
select count(*), min(m) from (select arrow_cast(concat('a-long-enough-string-view-key-', cast(v % 9973 as varchar)), 'Utf8View') as k, min(arrow_cast(concat('a-long-enough-string-view-value-', cast(v as varchar)), 'Utf8View')) m from t group by k);
----
9973 a-long-enough-string-view-value-1

query III
select count(*), sum(c), sum(s) from (select v % 101 as k1, concat('k', cast(v % 103 as varchar)) as k2, v % 7 = 0 as k3, count(*) c, sum(v) s from t group by k1, k2, k3);
----
20806 200000 20000100000

# null keys hash alike
query II
select count(*), sum(c) from (select case when v % 11 = 0 then null else concat('key-', cast(v % 5003 as varchar)) end as k, count(*) c from t group by k);
----
5004 200000

statement ok
set datafusion.execution.hash_aggregate_bucket_threshold_bytes = 0;

query II
select count(*), sum(c) from (select concat('key-', cast(v % 9973 as varchar)) as k, count(*) c from t group by k);
----
9973 200000

# the partial aggregation converts rows to states without aggregating
statement ok
set datafusion.execution.skip_partial_aggregation_probe_rows_threshold = 1;

statement ok
set datafusion.execution.skip_partial_aggregation_probe_ratio_threshold = 0.0;

query II
select count(*), sum(c) from (select concat('key-', cast(v % 9973 as varchar)) as k, count(*) c from t group by k);
----
9973 200000

statement ok
reset datafusion.execution.skip_partial_aggregation_probe_rows_threshold;

statement ok
reset datafusion.execution.skip_partial_aggregation_probe_ratio_threshold;

statement ok
reset datafusion.execution.carry_group_hash;

statement ok
reset datafusion.execution.hash_aggregate_bucket_threshold_bytes;

statement ok
reset datafusion.execution.hash_aggregate_bucket_threshold;

statement ok
reset datafusion.execution.batch_size;

statement ok
drop table t;
